generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Google OAuth `sub` — same id as Blob `bnc/users.json` MemberUser.id
model Member {
  id          String   @id
  email       String
  displayName String
  image       String?
  createdAt   DateTime
  updatedAt   DateTime

  merchantId String?
  merchant   PartnerMerchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  registrations EventRegistration[]
  vouchers      Voucher[]
  pointLedger   PointLedger[]
  voucherSharesSent     VoucherShare[] @relation("VoucherShareSharer")
  voucherSharesReceived VoucherShare[] @relation("VoucherShareClaimer")
  teamFollows           TeamFollow[]
  identities            MemberIdentity[]
  roles                 MemberRole[]
  teamsCreated          Team[]            @relation("TeamCreator")
  teamMemberships       TeamMembership[]
  playerLinks           PlayerLink[]
}

enum MemberRoleType {
  FAN
  PLAYER
  LEADER
}

model MemberIdentity {
  id                String   @id @default(cuid())
  memberId          String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([memberId])
}

model MemberRole {
  id       String         @id @default(cuid())
  memberId String
  role     MemberRoleType

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, role])
  @@index([memberId])
}

model Team {
  id            String   @id @default(cuid())
  name          String
  bank          String
  jerseyColor1  String
  jerseyColor2  String
  createdById   String
  createdAt     DateTime @default(now())

  createdBy   Member           @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memberships TeamMembership[]
  entries     TeamEntry[]

  @@index([createdById])
}

model TeamMembership {
  id           String   @id @default(cuid())
  teamId       String
  memberId     String?
  nameZh       String
  nameEn       String
  idPartial    String
  staffId      String?
  jerseyNumber Int
  isCaptain    Boolean  @default(false)
  status       String   @default("listed")
  inviteToken  String?
  createdAt    DateTime @default(now())

  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([teamId, jerseyNumber])
  @@index([teamId])
  @@index([memberId])
}

model Competition {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  category   String
  registerBy DateTime
  rosterBy   DateTime
  feeNote    String
  createdAt  DateTime @default(now())

  entries TeamEntry[]
}

model TeamEntry {
  id                  String    @id @default(cuid())
  ref                 String    @unique @default(cuid())
  competitionId       String
  teamId              String
  leaderNameZh        String
  leaderNameEn        String
  leaderIdPartial     String
  leaderEmail         String
  leaderMobile        String
  leaderEmergency     String
  declarationAccepted DateTime?
  declarationBank     String?
  declarationSigned   String?
  status              String    @default("submitted")
  statusUpdatedAt     DateTime?
  createdAt           DateTime  @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([teamId])
}

model PlayerLink {
  id       String @id @default(cuid())
  memberId String
  leagueId String
  playerId String
  status   String @default("pending")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, leagueId, playerId])
  @@index([memberId])
}

model TeamFollow {
  id        String   @id @default(cuid())
  memberId  String
  leagueId  String
  teamId    String
  teamName  String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, leagueId, teamId])
  @@index([memberId])
}

/// Mirrors Blob ledger `registrations[]` (event signup rows).
model EventRegistration {
  ref          String    @id
  eventSlug    String
  eventTitle   String
  name         String
  phone        String
  email        String
  team         String
  needsJersey  String
  createdAt    DateTime
  checkedInAt  DateTime?
  memberId     String?
  member       Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([eventSlug])
  @@index([phone])
  @@index([email])
}

/// Mirrors Blob ledger `orders[]` (mock shop checkout).
model ShopOrder {
  ref              String   @id
  createdAt        DateTime
  name             String
  phone            String
  email            String
  note             String
  linesJson        String
  sampleTotalHkd   Int
  status           String   @default("mock_unpaid")
}

// --- B1 §5 CRM / vouchers (phase 2; schema reserved, no app surface yet) ---

model PartnerMerchant {
  id              String              @id @default(cuid())
  companyName     String
  contactWhatsapp String?
  address         String?
  loginEmail      String              @unique
  passwordHash    String
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  voucherTypes    VoucherType[]
  redemptions     VoucherRedemption[]
  linkedMembers   Member[]
}

model VoucherType {
  id                String           @id @default(cuid())
  name              String
  description       String?
  discountText      String?
  company           String?
  address           String?
  whatsapp          String?
  notes             String?
  validUntil        DateTime?
  sharePointsReward Int?
  merchantId        String?
  merchant          PartnerMerchant? @relation(fields: [merchantId], references: [id])
  vouchers          Voucher[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Voucher {
  id        String   @id @default(cuid())
  code      String   @unique
  status    String   @default("issued")
  typeId    String
  type      VoucherType @relation(fields: [typeId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  redemptions VoucherRedemption[]

  @@unique([typeId, memberId])
}

model VoucherRedemption {
  id         String          @id @default(cuid())
  voucherId  String
  voucher    Voucher         @relation(fields: [voucherId], references: [id])
  merchantId String
  merchant   PartnerMerchant @relation(fields: [merchantId], references: [id])
  method     String          @default("qr")
  redeemedAt DateTime        @default(now())
  note       String?

  @@index([merchantId, redeemedAt])
}

model VoucherShare {
  id              String   @id @default(cuid())
  sharerMemberId  String
  sharer          Member   @relation("VoucherShareSharer", fields: [sharerMemberId], references: [id], onDelete: Cascade)
  claimerMemberId String
  claimer         Member   @relation("VoucherShareClaimer", fields: [claimerMemberId], references: [id], onDelete: Cascade)
  voucherTypeId   String
  createdAt       DateTime @default(now())
}

model PointLedger {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

/// Synced from public ScoreLab season / team pages (BNC-017 B3).
model ScoreLabTeam {
  id         String   @id @default(cuid())
  scorelabId String
  leagueId   String
  leagueSlug String
  slug       String
  name       String
  image      String?
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  syncedAt   DateTime

  @@unique([leagueId, scorelabId])
  @@index([leagueId])
}

model ScoreLabPlayer {
  id             String   @id @default(cuid())
  scorelabId     String
  teamScorelabId String
  leagueId       String
  name           String
  number         String?
  image          String?
  active         Boolean  @default(true)
  former         Boolean  @default(false)
  syncedAt       DateTime

  seasons ScoreLabPlayerSeason[]

  @@unique([leagueId, scorelabId])
  @@index([leagueId])
  @@index([leagueId, teamScorelabId])
  @@index([name])
}

model ScoreLabPlayerSeason {
  id               String   @id @default(cuid())
  playerScorelabId String
  leagueId         String
  seasonId         String
  gamesPlayed      Int      @default(0)
  PTS              Int      @default(0)
  REB              Int      @default(0)
  AST              Int      @default(0)
  STL              Int      @default(0)
  BLK              Int      @default(0)
  threePM          Int      @default(0)
  efficiency       Int      @default(0)
  syncedAt         DateTime

  player ScoreLabPlayer @relation(fields: [playerScorelabId, leagueId], references: [scorelabId, leagueId])

  @@unique([playerScorelabId, leagueId, seasonId])
  @@index([leagueId, seasonId])
}

model ScoreLabSyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime
  finishedAt DateTime?
  ok         Boolean   @default(false)
  teams      Int       @default(0)
  players    Int       @default(0)
  errorsJson String?
}
